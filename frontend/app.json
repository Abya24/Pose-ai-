{
  "expo": {
    "name": "PoseMate AI",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.posematecamera.ayswde",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos with live pose and lighting guidance",
        "NSMicrophoneUsageDescription": "Ask ABYA photography questions by voice",
        "NSPhotoLibraryUsageDescription": "Pick photos to edit and design",
        "NSPhotoLibraryAddUsageDescription": "Save your edited photos to your gallery",
        "NSMotionUsageDescription": "Show a horizon level while you shoot"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.posematecamera.ayswde",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-audio",
        { "microphonePermission": "Ask ABYA photography questions by voice" }
      ],
      "expo-sharing",
      "@react-native-vector-icons/ionicons",
      [
        "expo-camera",
        { "cameraPermission": "Take photos with live pose and lighting guidance", "recordAudioAndroid": false }
      ],
      [
        "expo-media-library",
        { "savePhotosPermission": "Save your edited photos to your gallery", "isAccessMediaLocationEnabled": false }
      ],
      [
        "expo-image-picker",
        { "photosPermission": "Pick photos to edit and design" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
